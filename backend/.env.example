# Copy to .env. All keys are optional: users can enter their own key in the UI.
# A key set here becomes the fallback for that provider when the user leaves the field blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
